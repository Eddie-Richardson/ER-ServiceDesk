# ER-ServiceDesk/.env.example
# Example environment variables for local development
#
# This file provides sample configuration values for running the
# ER‑ServiceDesk application locally. Developers can copy this file
# to `.env` and adjust values as needed for their environment.
# These variables are loaded automatically by Pydantic's BaseSettings.

# ---------------------------------------------------------------------------
# PostgreSQL connection string
# ---------------------------------------------------------------------------
# Format:
# postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/erservicedesk

# ---------------------------------------------------------------------------
# Redis connection string
# ---------------------------------------------------------------------------
# Format:
# redis://<host>:<port>/<db_number>
REDIS_URL=redis://redis:6379/0
