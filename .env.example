# ER-ServiceDesk/.env.example
# Example environment variables for local development.
#
# Matches exactly what a real install's own .env contains -- see
# WriteEnvFiles in installer/setup.iss, the actual, real source of
# truth for what gets written. Copy this file to `.env` and replace
# every placeholder value; DATABASE_URL's host stays "db" (the
# docker-compose service name, resolved via the Docker network) --
# don't change that one to "localhost".
#
# Business name, email credentials, and SMTP/IMAP settings are
# deliberately NOT here -- those are real SystemSetting rows in the
# database now, edited through Settings -> Business Info once the app
# is running, not environment variables at all.
#
# REDIS_URL, ALGORITHM, and ACCESS_TOKEN_EXPIRE_MINUTES aren't listed
# either -- Settings (app/core/config.py) already has sensible
# defaults for all three, so a real install's own .env never needs to
# set them; only include one of these if you genuinely want to
# override that default.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_DB=erservicedesk

DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-real-password@db:5432/erservicedesk

SECRET_KEY=replace-with-a-real-random-value

# Separate, dedicated key for encrypting device user-account passwords
# at rest -- deliberately not SECRET_KEY, since reusing one key across
# different cryptographic purposes (JWT signing vs. symmetric
# encryption) is bad practice. See app/core/encryption.py.
DEVICE_ACCOUNT_ENCRYPTION_KEY=replace-with-a-real-random-value

# docker-compose.yml's own log volume mount reads this rather than a
# fixed path -- Local resolves it against Docker Desktop on this same
# Windows machine (a real Windows path); Server instead runs against
# the remote Docker daemon inside its own Ubuntu VM over TCP, which
# resolves it on that VM's own Linux filesystem instead (see
# WriteEnvFiles in installer/setup.iss for the real, exact values each
# mode writes, and create_server_vm.ps1's own cloud-init provisioning
# for where the Server-mode directory actually gets created).
LOG_HOST_DIR=C:/ProgramData/ER-ServiceDesk/logs

# ---------------------------------------------------------------------------
# Local pytest runs only -- not written by the real installer at all,
# and not read by the app itself (see tests/conftest.py). Uses
# "localhost", not "db" -- pytest runs natively, outside the Docker
# network, so it reaches Postgres through the port docker-compose.yml
# exposes on the host instead. Update the password here to match
# POSTGRES_PASSWORD above after every fresh install, since that value
# changes on each one.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-real-password@localhost:5432/erservicedesk_test
